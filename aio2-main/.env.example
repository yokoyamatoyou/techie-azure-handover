############################################
# SEO/AIO Analyzer - env template
# - Copy to ".env" and set values as needed.
# - LLM usage requires OPENAI_API_KEY.
############################################

# === LLM / OpenAI ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_HIGH_REASONING_MODEL=gpt-4.1
OPENAI_TIMEOUT=60
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_RETRIES=3

# === Network / Fetch ===
TIMEOUT_DEFAULT=5
TIMEOUT_LONG=30
TIMEOUT_SHORT=3
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) SEO-AIO-Analyzer/2.0
MAX_FETCH_BYTES=10485760
FETCH_TIMEOUT=30
FETCH_MAX_REDIRECTS=5
WARN_LARGE_HTML_BYTES=5242880

# === Crawl ===
CRAWL_INTERVAL_SECONDS=1.0
MAX_CRAWL_DEPTH=2
MAX_PAGES_PER_DOMAIN=50

# === Output gate / Legal context ===
ENABLE_OUTPUT_GATE=1
LEGAL_GATE_MODEL=
LEGAL_STRICT_TEMPERATURE=0.1
LEGAL_CONSUMER_TEMPERATURE=0.6
LEGAL_GATE_TEMPERATURE=0.1
ENABLE_LEGAL_CONTEXT_LLM=1
LEGAL_CONTEXT_MODEL=
LEGAL_CONTEXT_TEMPERATURE=0.1
LEGAL_CONTEXT_THRESHOLD=0.65
LEGAL_CONTEXT_MAX_ISSUES=5

# === Wikidata ===
ENABLE_WIKIDATA=1
WIKIDATA_TOP_K=3

# === PDF / Fonts ===
PDF_FONT_REGULAR=NotoSansJP-Regular.ttf
PDF_FONT_BOLD=NotoSansJP-Bold.ttf

# === Server ===
PORT=8501
