{
  "llm": {
    "model_name": "gpt-4.1-mini-2025-04-14",
    "fallback_model": "gpt-5-nano",
    "reasoning_effort": "none",
    "timeout": 120,
    "top_p": 0.9,
    "presence_penalty": 0.2,
    "frequency_penalty": 0.1,
    "disable_temperature_model_prefixes": [
      "gpt-5",
      "o3",
      "o1"
    ],
    "disable_top_p_model_prefixes": [
      "gpt-5"
    ],
    "disable_penalty_model_prefixes": [
      "gpt-5",
      "o3",
      "o1"
    ],
    "allow_model_fallback": false,
    "max_same_model_retries": 2,
    "retryable_error_classes": [
      "rate_limit",
      "timeout",
      "upstream_5xx",
      "network_reset"
    ],
    "task_models": {
      "route_v": "gpt-4.1",
      "section": "gpt-5.4-mini",
      "outline": "gpt-5.4",
      "lead": "gpt-5.4",
      "image_display_text": "gpt-5.4-mini"
    },
    "article_type_params": {
      "announcement": {
        "temperature": 0.15,
        "verbosity": "low",
        "presence_penalty": 0.0,
        "frequency_penalty": 0.0
      },
      "explanatory_article": {
        "temperature": 0.35,
        "verbosity": "high",
        "presence_penalty": 0.2,
        "frequency_penalty": 0.1
      },
      "branding": {
        "temperature": 0.5,
        "verbosity": "high",
        "presence_penalty": 0.35,
        "frequency_penalty": 0.15
      },
      "daily_story": {
        "temperature": 0.7,
        "verbosity": "medium",
        "presence_penalty": 0.5,
        "frequency_penalty": 0.15
      },
      "case_study": {
        "temperature": 0.4,
        "verbosity": "high",
        "presence_penalty": 0.2,
        "frequency_penalty": 0.1
      },
      "industry_analysis": {
        "temperature": 0.3,
        "verbosity": "high",
        "presence_penalty": 0.15,
        "frequency_penalty": 0.1
      },
      "comparative_review": {
        "temperature": 0.28,
        "verbosity": "high",
        "presence_penalty": 0.15,
        "frequency_penalty": 0.1
      }
    }
  },
  "writer_only": {
    "family": "gpt-4.1",
    "model": "gpt-4.1-mini-2025-04-14",
    "api": "responses",
    "parameters": {
      "temperature": 0.72,
      "top_p": 0.9,
      "max_output_tokens": 7000,
      "store": false
    }
  },
  "security": {
    "prompt_injection_mode": "block",
    "blocked_input_fields": [
      "prompt_raw",
      "topic",
      "speaker_profile",
      "audience_profile",
      "topic_statement",
      "core_message"
    ],
    "extra_injection_patterns": []
  },
  "source_reading": {
    "max_chars_per_source": 12000,
    "quality_context_source_text_max_chars": 12000,
    "style_drift_source_text_max_chars": 12000
  },
  "human_resonance": {
    "phrase_max_per_paragraph": 2,
    "phrase_probability": 0.75,
    "phrase_min_occurrences": 2,
    "pronoun_reduction_ratio": 0.5,
    "pronoun_reduction_min_count": 4,
    "use_llm_for_editor": false,
    "use_llm_for_legal": true
  },
  "images": {
    "model_name": "gpt-image-2",
    "fallback_model": "gpt-image-1.5",
    "description_model_name": "gpt-5.4-mini",
    "description_fallback_model": "gpt-4.1-mini-2025-04-14",
    "quality": "low",
    "text_quality": "medium",
    "size": "1280x672",
    "count": 2,
    "output_format": "jpeg",
    "background": "opaque",
    "moderation": "auto",
    "note_width": 1280,
    "note_height": 670,
    "no_text_in_image": true,
    "text_overlay_font_path": "",
    "generated_images_dir": ""
  },
  "quality_pipeline": {
    "enabled": true,
    "mode": "enforce",
    "mode_runbook": {
      "shadow": "計測のみ。品質影響を観測する期間に使用。",
      "enforce": "実修正を適用。A/B検証で問題ないことを確認後に段階適用。",
      "switch_steps": [
        "1) shadowでphase reportと失敗率を確認",
        "2) rollout_percentを小さくしてenforceに切替",
        "3) 指標悪化時はshadowへ戻して原因分析"
      ]
    },
    "rollout_percent": 100,
    "fail_open": true,
    "phase01_lexical_enabled": true,
    "phase01_tokenizer": "auto",
    "phase02_burstiness_enabled": true,
    "phase03_nominalization_enabled": true,
    "phase04_style_drift_enabled": true,
    "phase05_layout_guard_enabled": true,
    "phase06_orchestrator_enabled": true,
    "phase07_rollout_enabled": true,
    "lexical_threshold": 0.32,
    "burstiness_target_min": 0.18,
    "burstiness_target_max": 0.52,
    "nominalization_alert_threshold": 0.18,
    "style_alignment_min_score": 0.72,
    "domain_guard_strictness": "normal",
    "supplement_min_position_ratio": 0.45,
    "intro_max_length_ratio": 0.35,
    "section_coherence_min_score": 0.4,
    "global_rewrite_ratio_cap": 0.2,
    "conflict_resolution_policy": "safe_first",
    "quality_gate_min_score": 0.55,
    "max_rewrite_ratio": 0.15,
    "max_sentence_split_ratio": 0.12,
    "max_nominalization_rewrite_ratio": 0.12,
    "resonance_tuning_enabled": false
  },
  "style_profiles": {
    "column": {
      "bracket_limit": 3,
      "ambiguous_word_limit": 5,
      "emotional_waveform": "dynamic",
      "digression_allowed": true,
      "orthographic_variation_rate": 0.2
    },
    "how_to": {
      "bracket_limit": 2,
      "ambiguous_word_limit": 3,
      "emotional_waveform": "steady",
      "digression_allowed": false,
      "orthographic_variation_rate": 0.1
    },
    "opinion": {
      "bracket_limit": 4,
      "ambiguous_word_limit": 6,
      "emotional_waveform": "rising",
      "digression_allowed": true,
      "orthographic_variation_rate": 0.25
    },
    "announcement": {
      "bracket_limit": 1,
      "ambiguous_word_limit": 1,
      "emotional_waveform": "flat",
      "digression_allowed": false,
      "orthographic_variation_rate": 0.0
    },
    "hobby": {
      "bracket_limit": 5,
      "ambiguous_word_limit": 7,
      "emotional_waveform": "dynamic",
      "digression_allowed": true,
      "orthographic_variation_rate": 0.3
