    "strict": {
      "sentence_length_cv": 0.15,
      "paragraph_length_cv": 0.15,
      "conjunction_repetition_rate_high": 0.4,
      "subject_explicit_rate_high": 0.45,
      "particle_entropy_low": 2.0,
      "pos_bigram_monotonicity_low": 0.5,
      "mtld_low": 50.0,
      "nominalization_rate_high": 0.2
    }
