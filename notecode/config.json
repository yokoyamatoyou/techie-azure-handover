    "standard": {
      "sentence_length_cv": 0.1,
      "paragraph_length_cv": 0.1,
      "conjunction_repetition_rate_high": 0.5,
      "subject_explicit_rate_high": 0.55,
      "particle_entropy_low": 1.8,
      "pos_bigram_monotonicity_low": 0.4,
      "mtld_low": 40.0,
      "nominalization_rate_high": 0.25
