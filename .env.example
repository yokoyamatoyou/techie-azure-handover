# ============================================================
# TECHIE SaaS — Docker Compose 用環境変数テンプレート
# cp .env.example .env して値を設定してください
# ============================================================

# === OpenAI ===
OPENAI_API_KEY=

# === Microsoft Entra External ID (legacy AZURE_B2C_* also supported) ===
AUTH_IDENTITY_MODE=entra_external_id
ENTRA_EXTERNAL_ID_TENANT_NAME=
ENTRA_EXTERNAL_ID_TENANT_ID=
ENTRA_EXTERNAL_ID_CLIENT_ID=
ENTRA_EXTERNAL_ID_POLICY=B2C_1_signup_signin
ENTRA_EXTERNAL_ID_ISSUER=
ENTRA_EXTERNAL_ID_DISCOVERY_URL=
# legacy | shadow | enforce. Deploy schema first, then shadow, then enforce.
AUTH_IDENTITY_RESOLVER_MODE=legacy
# Keep disabled until Entra custom-attribute write controls are audited.
AUTH_TRUST_ENTRA_BINDING_CLAIMS=0
# Enable only with resolver=enforce after collision and rollback preflight.
AUTH_IDENTITY_AUTO_PROVISION=0
AZURE_B2C_TENANT_NAME=
AZURE_B2C_CLIENT_ID=
AZURE_B2C_POLICY=B2C_1_signup_signin

# === Stripe (テストモード可) ===
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# === Storage ===
# local | azure_blob
STORAGE_BACKEND=local
AZURE_STORAGE_CONNECTION_STRING=
