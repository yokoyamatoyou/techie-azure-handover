  "experience_pattern": {
    "enabled": true,
    "auto_detect": true,
    "rules": {
      "new_service": {
        "keywords": [
          "新サービス",
          "新規",
          "ローンチ",
          "リリース",
          "ベータ",
          "プレビュー"
        ],
        "allow_experience": false,
        "reason": "新サービス解説では体験談が不自然なため"
      },
      "established_service": {
        "keywords": [
          "既存",
          "従来",
          "これまで",
          "従来から",
          "長年",
          "定番"
        ],
        "allow_experience": true,
        "reason": "従来サービスでは体験談が自然なため"
      },
      "technical_analysis": {
        "keywords": [
          "技術",
          "仕様",
          "アーキテクチャ",
          "API",
          "システム",
          "構成"
        ],
        "allow_experience": false,
        "reason": "技術解説では事実優先のため"
      },
      "case_study": {
        "keywords": [
          "事例",
          "ケーススタディ",
          "導入事例",
          "活用事例"
        ],
        "allow_experience": true,
        "reason": "事例紹介では具体的体験が価値のため"
      }
    },
    "fallback_policy": "conservative"
  },
  "cognitive_drift": {
    "enabled": true,
    "paragraph_enabled": true,
