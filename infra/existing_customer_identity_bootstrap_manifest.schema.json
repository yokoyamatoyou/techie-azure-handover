{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://techie.invalid/schemas/existing-customer-identity-bootstrap-v1.json",
  "title": "TECHIE existing-customer identity bootstrap manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "change_approval_receipt_sha256",
    "expected_operation_count",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "techie-existing-customer-identity-bootstrap-v1"
    },
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "change_approval_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_operation_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "business_tenant_id",
          "expected_customer_account_id_sha256",
          "expected_stripe_customer_id_sha256",
          "directory_tenant_id",
          "token_issuer",
          "subject_type",
          "subject_value",
          "entra_object_id",
          "identity_provider",
          "identity_evidence_receipt_sha256"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "business_tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "expected_customer_account_id_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expected_stripe_customer_id_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "directory_tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "token_issuer": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "subject_type": {
            "const": "oid"
          },
          "subject_value": {
            "type": "string",
            "format": "uuid"
          },
          "entra_object_id": {
            "type": "string",
            "format": "uuid"
          },
          "identity_provider": {
            "enum": ["email", "google", "microsoft"]
          },
          "identity_evidence_receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
