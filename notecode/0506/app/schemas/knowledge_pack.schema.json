{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.bloggen/schemas/knowledge_pack.schema.json",
  "title": "Article Knowledge Pack",
  "type": "object",
  "required": ["article_knowledge_pack"],
  "additionalProperties": false,
  "properties": {
    "article_knowledge_pack": {
      "type": "object",
      "required": [
        "pack_id",
        "source_card_ids",
        "confirmed_facts",
        "conflicts",
        "deduped_themes",
        "do_not_infer"
      ],
      "additionalProperties": false,
      "properties": {
        "pack_id": {"type": "string", "minLength": 1},
        "source_card_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "confirmed_facts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/confirmed_fact"}
        },
        "conflicts": {
          "type": "array",
          "items": {"$ref": "#/$defs/conflict"}
        },
        "deduped_themes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "do_not_infer": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "confirmed_fact": {
      "type": "object",
      "required": [
        "claim_id",
        "claim",
        "supporting_fact_ids",
        "confidence",
        "preferred_expression"
      ],
      "additionalProperties": false,
      "properties": {
        "claim_id": {"type": "string", "pattern": "^C[0-9]{3,}$"},
        "claim": {"type": "string", "minLength": 1},
        "supporting_fact_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^F[0-9]{3,}$"},
          "uniqueItems": true
        },
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "preferred_expression": {"type": "string", "minLength": 1},
        "risk_flags": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "conflict": {
      "type": "object",
      "required": ["issue", "involved_fact_ids", "resolution", "do_not_mention"],
      "additionalProperties": false,
      "properties": {
        "issue": {"type": "string", "minLength": 1},
        "involved_fact_ids": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "pattern": "^F[0-9]{3,}$"},
          "uniqueItems": true
        },
        "resolution": {"type": "string", "minLength": 1},
        "do_not_mention": {"type": "boolean"}
      }
    }
  }
}
