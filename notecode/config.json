    "technical": {
      "bracket_limit": 2,
      "ambiguous_word_limit": 2,
      "emotional_waveform": "steady",
      "digression_allowed": false,
      "orthographic_variation_rate": 0.05
    }
  },
  "fingerprint_threshold_presets": {
    "active_preset": "superhuman",
